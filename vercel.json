{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd myproject/frontend && npm ci",
  "buildCommand": "cd myproject/frontend && npm run build",
  "outputDirectory": "myproject/frontend/dist",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index.py"
    }
  ]
}
